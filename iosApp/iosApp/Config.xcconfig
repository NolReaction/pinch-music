// Shared by Debug and Release. Set your own bundle identifier and team for device signing.
PRODUCT_BUNDLE_IDENTIFIER = ru.vtakt.dev
PRODUCT_NAME = PinchMusic
MARKETING_VERSION = 0.4.0
CURRENT_PROJECT_VERSION = 4
CODE_SIGN_STYLE = Automatic

IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SDKROOT = iphoneos
SWIFT_VERSION = 5.0

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_FILE = iosApp/Info.plist
GENERATE_INFOPLIST_FILE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
SWIFT_OBJC_BRIDGING_HEADER = iosApp/StageBridge.h
CLANG_CXX_LANGUAGE_STANDARD = c++17
OTHER_LDFLAGS = $(inherited) -ObjC -framework ComposeApp -framework OpenGLES -framework GLKit
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
