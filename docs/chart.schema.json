{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RhythmDemoChart",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "bpm", "timeSignature", "leadInMs", "durationMs", "video", "audio", "notes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "bpm": {"type": "number", "exclusiveMinimum": 0},
    "timeSignature": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "leadInMs": {"type": "integer", "minimum": 0},
    "durationMs": {"type": "integer", "minimum": 1},
    "video": {
      "type": "object",
      "required": ["file", "fps", "width", "height", "chartTimeAtVideoZeroMs"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "chartTimeAtVideoZeroMs": {"const": 0}
      }
    },
    "audio": {
      "type": "object",
      "required": ["mode", "sampleRateHz", "sampleDirectory"],
      "properties": {
        "mode": {"const": "oneShotSamples"},
        "sampleRateHz": {"type": "integer", "minimum": 8000},
        "sampleDirectory": {"type": "string", "minLength": 1}
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "atMs", "midi", "durationMs", "velocity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "atMs": {"type": "integer", "minimum": 0},
          "midi": {"type": "integer", "minimum": 0, "maximum": 127},
          "durationMs": {"type": "integer", "minimum": 1},
          "velocity": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$comment": "Additionally validate unique note IDs, ascending onset times, available samples and video, and note timing within duration. These cross-field checks are not fully expressed by this schema."
}
